<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_receipt" model="ir.ui.view">
        <field name="name">account.move.form.receipt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <!-- Add "Create Receipt" button (only visible on a posted vendor bill without receipt) -->
            <xpath expr="//header" position="inside">
                <!-- Needed by the button modifier below (each inheriting view is validated on its own) -->
                <field name="receipt_count" invisible="1"/>
                <button name="action_create_receipt"
                        type="object"
                        string="Create Receipt"
                        class="oe_highlight"
                        invisible = "move_type != 'in_invoice' or state != 'posted' or receipt_count > 0"
                />
            </xpath>


        </field>
    </record>
                <record id="view_move_form_inherit_receipt" model="ir.ui.view">
                    <field name="name">account.move.form.inherit.receipt</field>
                    <field name="model">account.move</field>
                    <field name="inherit_id" ref="account.view_move_form"/>
                    <field name="arch" type="xml">
                        <div name="button_box" position="inside">
                                <button name="action_view_receipt_orders"
                                        class="oe_stat_button"
                                        type="object"
                                        string="Receipts "
                                        icon="fa-truck"
                                        invisible ="move_type != 'in_invoice'">
                                    <field name="receipt_count" widget="statinfo"/>
                                </button>
                        </div>
                    </field>
                </record>
</odoo>
